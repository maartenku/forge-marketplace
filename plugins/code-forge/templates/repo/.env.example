# Copy to .env and fill in. Every variable the app reads must be listed here. No real secrets in this file.
ASPNETCORE_ENVIRONMENT=Development
API_URL=http://localhost:5000
WEB_URL=http://localhost:4200

# data (sandbox defaults)
DB_PROVIDER=sqlite            # sqlite | sqlserver
DB_CONNECTION=Data Source=environments/sandbox/app.db
FS_ROOT=environments/sandbox/fs

# auth (dev only — rotate for any hosted environment)
JWT_ISSUER={{PROJECT_SLUG}}
JWT_AUDIENCE={{PROJECT_SLUG}}
JWT_SIGNING_KEY=dev-only-change-me-dev-only-change-me-32chars
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=Admin!Dev1
DEV_USER_EMAIL=user@dev.local
DEV_USER_PASSWORD=User!Dev1
